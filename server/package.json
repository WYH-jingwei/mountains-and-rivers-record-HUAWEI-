{
  "name": "server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts",
    "serve": "tsx --env-file-if-exists=.env src/serve.ts",
    "verify": "tsx --env-file-if-exists=.env src/run-verify.ts",
    "verify:rag": "tsx --env-file-if-exists=.env src/run-rag-calibration.ts",
    "db:init": "tsx --env-file-if-exists=.env src/db/init-db.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "mysql2": "^3.24.6",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
