# ===== MySQL（华为云 RDS for MySQL / 本地 MySQL 8.x）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=history_geo_classroom

# ===== Redis（缓存；本地无实例或留空时自动降级，不影响主流程）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=

# ===== 华为云盘古 MaaS（对话 + 向量，同一个 API Key）=====
# 对话根路径（OpenAI 兼容）
LLM_BASE_URL=https://api.modelarts-maas.com/openai/v1
# 向量根路径
EMBEDDING_BASE_URL=https://api.modelarts-maas.com/v1
# 在华为云「API Key 管理」创建后填入；留空则降级为关键词检索
LLM_API_KEY=
# 对话模型：华为自研盘古 openPangu-2.0-Flash（轻量快速档，512K 上下文；
# 四档分级/出处/地图动作由规则引擎决定，模型仅负责把结论润色为自然语言，故选低成本档）
# 如需更强复杂推理可切换为 openpangu-2.0-pro
LLM_MODEL=openpangu-2.0-flash
# 向量模型：BGE-M3（预置服务，中英文，标准 embeddings 端点）
EMBEDDING_MODEL=bge-m3
